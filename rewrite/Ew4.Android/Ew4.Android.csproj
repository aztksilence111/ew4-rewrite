<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>org.ew4.reconstruction</ApplicationId>
    <ApplicationTitle>欧陆战争4 重构</ApplicationTitle>
    <ApplicationVersion>23</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.20</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Register JNI callbacks at runtime when publishing untrimmed assemblies. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
  </PropertyGroup>
  <!-- Copy-mode linking keeps the A/B assembly surface intact. The Android SDK
       requires its linker pipeline even for an otherwise untrimmed AOT build. -->
  <PropertyGroup Condition="'$(Ew4AotExperiment)' == 'aot' Or '$(Ew4AotExperiment)' == 'jit'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>copy</TrimMode>
    <RunAOTCompilation Condition="'$(Ew4AotExperiment)' == 'aot'">true</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(Ew4AotExperiment)' == 'jit'">false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Ew4RuntimeAot" Value="$(RunAOTCompilation)" />
    <ProjectReference Include="../Ew4.Client/Ew4.Client.csproj" />
    <ProjectReference Include="../Ew4.Mods/Ew4.Mods.csproj" />
    <AndroidAsset Include="../Ew4.Web/wwwroot/**/*" Link="www/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../data/client/**/*" Link="www/content/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../data/original/**/*" Link="original/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../data/legacy/*.json" Link="data/%(Filename)%(Extension)" />
    <AndroidAsset Include="../data/rewrite/**/*" Link="rewrite/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../mod-kit/THIRD_PARTY_NOTICES.md" Link="licenses/THIRD_PARTY_NOTICES.md" />
    <AndroidAsset Include="../mod-kit/licenses/MoonSharp-LICENSE.txt" Link="licenses/MoonSharp-LICENSE.txt" />
    <AndroidAsset Include="../mod-kit/licenses/PixiJS-LICENSE.txt" Link="licenses/PixiJS-LICENSE.txt" />
  </ItemGroup>
  <Import Project="../Frontend.Build.targets" />
</Project>
