<Project>
  <ItemGroup>
    <_CompatibleFrontendRoot Include="$(MSBuildThisFileDirectory)Ew4.Web/wwwroot/*.js;$(MSBuildThisFileDirectory)Ew4.Web/wwwroot/*.css" />
    <_CompatibleFrontendVendor Include="$(MSBuildThisFileDirectory)Ew4.Web/wwwroot/vendor/*.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Ew4.Web'">
    <Content Remove="wwwroot/compat/**/*" />
    <Content Include="@(_CompatibleFrontendRoot->'wwwroot/compat/%(Filename)%(Extension)')" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="@(_CompatibleFrontendVendor->'wwwroot/compat/vendor/%(Filename)%(Extension)')" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/compat/manifest.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Ew4.Android'">
    <AndroidAsset Remove="../Ew4.Web/wwwroot/compat/**/*" />
    <AndroidAsset Include="@(_CompatibleFrontendRoot->'../Ew4.Web/wwwroot/compat/%(Filename)%(Extension)')" Link="www/compat/%(Filename)%(Extension)" />
    <AndroidAsset Include="@(_CompatibleFrontendVendor->'../Ew4.Web/wwwroot/compat/vendor/%(Filename)%(Extension)')" Link="www/compat/vendor/%(Filename)%(Extension)" />
    <AndroidAsset Include="../Ew4.Web/wwwroot/compat/manifest.json" Link="www/compat/manifest.json" />
  </ItemGroup>
  <Target Name="BuildCompatibleFrontend" BeforeTargets="PrepareForBuild;Compile;PrepareForPublish;ComputeFilesToPublish;_ComputeAndroidAssets" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../tools/frontend/node_modules/esbuild/package.json')" Text="Install the pinned frontend build tools first: npm --prefix tools/frontend ci --no-audit --no-fund" />
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)../tools/frontend/build.cjs&quot;" />
  </Target>
</Project>
