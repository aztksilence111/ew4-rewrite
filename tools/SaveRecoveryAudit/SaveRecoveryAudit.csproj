<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(Ew4RuntimeRoot)' == ''">
    <ProjectReference Include="../../rewrite/Ew4.Client/Ew4.Client.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Ew4RuntimeRoot)' != ''">
    <Reference Include="Ew4.Client"><HintPath>$(Ew4RuntimeRoot)/Ew4.Client.dll</HintPath></Reference>
    <Reference Include="Ew4.Core"><HintPath>$(Ew4RuntimeRoot)/Ew4.Core.dll</HintPath></Reference>
    <Reference Include="Ew4.Legacy"><HintPath>$(Ew4RuntimeRoot)/Ew4.Legacy.dll</HintPath></Reference>
    <Reference Include="Ew4.Persistence"><HintPath>$(Ew4RuntimeRoot)/Ew4.Persistence.dll</HintPath></Reference>
    <Reference Include="MoonSharp.Interpreter"><HintPath>$(Ew4RuntimeRoot)/MoonSharp.Interpreter.dll</HintPath></Reference>
  </ItemGroup>
</Project>
